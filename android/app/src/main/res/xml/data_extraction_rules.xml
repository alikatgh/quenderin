<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules.
     Downloaded model weights and private chat/approved-memory text are excluded
     from both cloud backup and device transfer. Optional Step 5 sends require
     their own consent and do not change these storage exclusions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="conversations/" />
        <exclude domain="file" path="approved-memories/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="conversations/" />
        <exclude domain="file" path="approved-memories/" />
    </device-transfer>
</data-extraction-rules>
