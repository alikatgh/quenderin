if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set(QUENDERIN_SPEECH_MINIMUM_OS_KEY MinimumOSVersion)
  if(CMAKE_OSX_SYSROOT MATCHES "iphonesimulator" OR CMAKE_OSX_ARCHITECTURES MATCHES "x86_64")
    set(QUENDERIN_SPEECH_SUPPORTED_PLATFORM iPhoneSimulator)
  else()
    set(QUENDERIN_SPEECH_SUPPORTED_PLATFORM iPhoneOS)
  endif()
else()
  set(QUENDERIN_SPEECH_MINIMUM_OS_KEY LSMinimumSystemVersion)
  set(QUENDERIN_SPEECH_SUPPORTED_PLATFORM MacOSX)
endif()
set(QUENDERIN_SPEECH_MINIMUM_OS_VERSION "${CMAKE_OSX_DEPLOYMENT_TARGET}")
