// The config behind https://quenderin.org — the site is served by a WORKER named
// "quenderin" with a Workers custom-domain binding (NOT the Pages project; Pages is the
// preview at quenderin.pages.dev). `scripts/deploy_website.sh` deploys this.
// Static pages plus one cached, public-metadata endpoint for fresh model discovery.
{
  "name": "quenderin",
  "main": "./workers/site.mjs",
  "build": {
    "command": "python3 scripts/check_catalog_parity.py && python3 scripts/generate_website_catalog.py"
  },
  "compatibility_date": "2026-07-04",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
